# Reproducible image inputs captured from the source host.
DSH_VERSION=0.1.1-rc.2
PNPM_VERSION=11.7.0
DOCKER_CLI_VERSION=29.6.0
DOCKER_CLI_IMAGE=docker@sha256:d14410ab6f87a2b6c14b7150de787cd7b8bb012a8e900966d6d893e9f7fc49b6
HARNESS_IMAGE=local/deepseek-harness:0.1.1-rc.2-portable
GATEWAY_IMAGE=local/deepseek-harness-gateway:0.1.0-portable
ROUTER_IMAGE=local/deepseek-harness-ollama-router:0.1.0
OLLAMA_IMAGE=ollama/ollama@sha256:77f1a2a54460f0380f2611e1464233d9b82cb6e58afc8f60abec0061049d2d82

# deploy.sh atomically records the explicitly selected topology before it can
# change Compose state. Do not set a conflicting value manually.
DSH_DEPLOYMENT_MODE=

# Per-host Harness values. scripts/configure.sh fills these automatically.
HARNESS_BIND_ADDRESS=127.0.0.1
HARNESS_HTTPS_PORT=3443
HARNESS_CA_PORT=3081
HARNESS_TRUSTED_HOSTS=127.0.0.1:3443,deepseek-harness.local:3443,localhost:3443
HARNESS_TLS_IP=127.0.0.1
HARNESS_TLS_DNS=deepseek-harness.local
HARNESS_AUTH_USERNAME=harness
HOST_WORKSPACE_ROOT=/workspace
HOST_USERNAME=harness
HOST_UID=1000
HOST_GID=1000
DOCKER_GID=999

# External mode: connect Harness to an existing Docker network where the
# Responses-compatible Ollama router is reachable as http://ai-router:11434.
OLLAMA_NETWORK=local-ai-ollama_default

# Remote mode: keep the canonical `ai-router` name inside Harness while the
# router runs on another host. The private network name is per deployment.
REMOTE_OLLAMA_HOST=192.168.1.21
DSH_NETWORK=deepseek-harness_default

# Managed mode: `./scripts/deploy.sh --managed-ollama` adds the pinned Ollama
# image and the vendored router. These values reproduce the live tuning.
MANAGED_OLLAMA_NETWORK=dsh-container_ollama
OLLAMA_STORE_DIR=./data/ollama
UNIFIED_MODELS_DIR=./data/ollama
OLLAMA_KEEP_ALIVE=-1
OLLAMA_CONTEXT_LENGTH=262144
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=f16
OLLAMA_SCHED_SPREAD=1
OLLAMA_LOAD_TIMEOUT=20m
# The source Ollama stack used its first three GPUs and excluded GPU index 3.
# Prefer destination-specific UUIDs if device ordering is not stable.
GPU_DEVICE_IDS=0,1,2
LLAMA_ARG_TENSOR_SPLIT=15,10,8
PULL_OLLAMA_MODELS=1
OLLAMA_UPSTREAM_TIMEOUT_MS=900000
RESPONSES_CONTEXT_SHIFT=false
MODEL_POLICY_MODE=active-only
REWRITE_REQUESTED_MODEL_TO_ACTIVE=true
FORCE_KEEP_ALIVE=-1
USE_ACTIVE_MODEL_WHEN_MISSING=false
ALLOW_MODEL_MANAGEMENT=false
REQUEST_HISTORY_LIMIT=500
EVENT_HISTORY_LIMIT=500
MAX_BODY_BYTES=0
PROMPT_LOGGING=metadata
ENABLE_NVIDIA_SMI=false
GPU_TELEMETRY_TIMEOUT_MS=2500
ROUTER_BIND_ADDRESS=127.0.0.1
ROUTER_PUBLIC_PORT=11434
ROUTER_ADMIN_BIND_ADDRESS=127.0.0.1
ROUTER_ADMIN_PORT=11435
ROUTER_ADMIN_ENABLED=true
# Set a token if you expose the admin port beyond loopback.
ROUTER_ADMIN_TOKEN=

# The constrained nvidia-smi proxy launches this already-local GPU image.
NVIDIA_SMI_IMAGE=ollama/ollama@sha256:77f1a2a54460f0380f2611e1464233d9b82cb6e58afc8f60abec0061049d2d82

# Captured OpenAI-compatible speech services on the private LAN. The matching
# keys live in secrets/stt_api_key and secrets/tts_api_key, never in this file.
# Empty the corresponding URL to disable a service on another deployment.
STT_BASE_URL=http://192.168.1.22:9000/v1
STT_MODEL=large-v3-turbo
STT_MAX_BYTES=33554432
STT_TIMEOUT_MS=120000
STT_MAX_RECORD_SECONDS=300
TTS_BASE_URL=http://192.168.1.22:8000/v1
TTS_MODEL=tts-1
TTS_VOICE=af_heart
TTS_MAX_BYTES=1048576
TTS_TIMEOUT_MS=180000
