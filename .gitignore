.env
.env.*
!.env.example

# Durable runtime state can contain sessions, workspace indexes, TLS private
# keys, password hashes, model blobs, and request metadata.
data/
backups/

# The home-network STT token is intentionally tracked so dictation works after
# deployment. Other service credentials remain local runtime configuration.
secrets/*
!secrets/.gitkeep
!secrets/stt_api_key

*.tar
*.tar.gz
*.tgz
__pycache__/
*.py[cod]
