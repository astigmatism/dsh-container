#!/bin/sh
set -eu

printf '%s\n' "$*" >>"${FAKE_DOCKER_LOG:?}"

case "${1:-}" in
  info)
    exit "${FAKE_DOCKER_INFO_EXIT:-0}"
    ;;
  inspect)
    if [ "${2:-}" = "${FAKE_COMPOSE_CONTAINER_ID:-__no_compose_container__}" ]; then
      [ "${FAKE_CONTAINER_IMAGE_INSPECT_EXIT:-0}" -eq 0 ] || exit "$FAKE_CONTAINER_IMAGE_INSPECT_EXIT"
      printf '%s\n' "${FAKE_CONTAINER_IMAGE_ID:?}"
      exit 0
    fi
    if [ "${2:-}" = "${FAKE_LOCK_CONTAINER_NAME:-__no_lock_container__}" ]; then
      [ "${FAKE_LOCK_CONTAINER_EXISTS:-1}" = 1 ] || exit 1
      case "$*" in
        *State.Running*)
          printf '%s %s\n' "${FAKE_LOCK_CONTAINER_ID:?}" "${FAKE_LOCK_CONTAINER_RUNNING:-true}"
          ;;
        *) printf '%s\n' "${FAKE_LOCK_CONTAINER_ID:?}" ;;
      esac
      exit 0
    fi
    case "$*" in
      *com.docker.compose.project.config_files*) ;;
      *com.docker.compose.project*)
        [ -n "${FAKE_CONTAINER_PROJECT:-}" ] || exit 1
        printf '%s\n' "$FAKE_CONTAINER_PROJECT"
        exit 0
        ;;
      *com.docker.compose.service*)
        [ -n "${FAKE_CONTAINER_SERVICE:-}" ] || exit 1
        printf '%s\n' "$FAKE_CONTAINER_SERVICE"
        exit 0
        ;;
      *)
        [ "${FAKE_CONTAINER_EXISTS:-0}" = 1 ] && exit 0
        ;;
    esac
    if [ -n "${FAKE_COMPOSE_LABELS:-}" ]; then
      printf '%s\n' "$FAKE_COMPOSE_LABELS"
      exit 0
    fi
    exit 1
    ;;
  network)
    exit "${FAKE_DOCKER_NETWORK_EXIT:-0}"
    ;;
  compose)
    for argument do
      case "$argument" in
        version) exit "${FAKE_COMPOSE_VERSION_EXIT:-0}" ;;
        config) exit "${FAKE_COMPOSE_CONFIG_EXIT:-0}" ;;
        ps)
          [ -z "${FAKE_COMPOSE_CONTAINER_ID:-}" ] || printf '%s\n' "$FAKE_COMPOSE_CONTAINER_ID"
          exit "${FAKE_COMPOSE_PS_EXIT:-0}"
          ;;
        images)
          if [ -n "${FAKE_COMPOSE_IMAGES:-}" ]; then
            printf '%s\n' "$FAKE_COMPOSE_IMAGES"
          fi
          exit "${FAKE_COMPOSE_IMAGES_EXIT:-0}"
          ;;
        stop) exit "${FAKE_COMPOSE_STOP_EXIT:-0}" ;;
        start) exit "${FAKE_COMPOSE_START_EXIT:-0}" ;;
        pull) exit "${FAKE_COMPOSE_PULL_EXIT:-0}" ;;
        build) exit "${FAKE_COMPOSE_BUILD_EXIT:-0}" ;;
        up) exit "${FAKE_COMPOSE_UP_EXIT:-0}" ;;
      esac
    done
    exit 0
    ;;
  image)
    exit 0
    ;;
  container)
    case "${2:-}" in
      rm) exit "${FAKE_CONTAINER_RM_EXIT:-0}" ;;
    esac
    exit 99
    ;;
  *)
    echo "Unexpected fake docker invocation: $*" >&2
    exit 99
    ;;
esac
