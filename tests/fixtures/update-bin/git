#!/bin/sh
set -eu

printf '%s\n' "$*" >>"${FAKE_GIT_LOG:?}"

repo_dir=
while [ "$#" -gt 0 ]; do
  case "$1" in
    -c) shift 2 ;;
    -C) repo_dir=$2; shift 2 ;;
    *) break ;;
  esac
done

case "${1:-}" in
  symbolic-ref)
    printf '%s\n' "${FAKE_GIT_BRANCH:-main}"
    ;;
  config)
    case "${3:-}" in
      branch.*.remote) printf '%s\n' "${FAKE_GIT_REMOTE:-origin}" ;;
      branch.*.merge) printf '%s\n' "${FAKE_GIT_MERGE_REF:-refs/heads/main}" ;;
      *) exit 1 ;;
    esac
    ;;
  remote)
    printf '%s\n' "${FAKE_GIT_ORIGIN_URL:-https://github.com/astigmatism/dsh-container.git}"
    ;;
  status)
    printf '%s' "${FAKE_GIT_DIRTY:-}"
    ;;
  fetch)
    exit "${FAKE_GIT_FETCH_EXIT:-0}"
    ;;
  merge-base)
    exit "${FAKE_GIT_MERGE_BASE_EXIT:-0}"
    ;;
  merge)
    merge_exit=${FAKE_GIT_MERGE_EXIT:-0}
    [ "$merge_exit" -eq 0 ] || exit "$merge_exit"
    if [ -n "${FAKE_FAST_FORWARD_SOURCE:-}" ]; then
      for source_file in "$FAKE_FAST_FORWARD_SOURCE"/scripts/*; do
        target_name=${source_file##*/}
        temporary=$(mktemp "${repo_dir:?missing fake repository path}/scripts/.fast-forward.XXXXXX")
        cp "$source_file" "$temporary"
        chmod 0755 "$temporary"
        mv "$temporary" "$repo_dir/scripts/$target_name"
      done
    fi
    if [ -n "${FAKE_GIT_STATE_FILE:-}" ]; then
      printf '%s\n' "${FAKE_GIT_TARGET:-2222222222222222222222222222222222222222}" \
        >"$FAKE_GIT_STATE_FILE"
    fi
    ;;
  hash-object)
    printf '%s\n' "${FAKE_RUNTIME_SETTINGS_OBJECT:-same-settings-object}"
    ;;
  rev-parse)
    case "${2:-}" in
      HEAD)
        if [ -s "${FAKE_GIT_STATE_FILE:-}" ]; then
          cat "$FAKE_GIT_STATE_FILE"
        else
          printf '%s\n' "${FAKE_GIT_HEAD:-1111111111111111111111111111111111111111}"
        fi
        ;;
      FETCH_HEAD) printf '%s\n' "${FAKE_GIT_TARGET:-2222222222222222222222222222222222222222}" ;;
      --short) printf '%s\n' "${FAKE_GIT_SHORT_HEAD:-2222222}" ;;
      *:config/settings.yaml) printf '%s\n' "${FAKE_TARGET_SETTINGS_OBJECT:-same-settings-object}" ;;
      *) exit 1 ;;
    esac
    ;;
  *)
    echo "Unexpected fake git invocation: $*" >&2
    exit 99
    ;;
esac
